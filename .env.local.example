# ─── Database ──────────────────────────────────────────────────────────────────
# Get this from your Neon dashboard → Connection String
# Use the "pooled" connection string for Vercel deployments
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-random-32-character-secret-here"
# Local dev URL. Change to your Vercel domain in production.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Pusher (Real-time messaging) ─────────────────────────────────────────────
# Create a free app at https://pusher.com → Channels
# Enable: Private channels ON. Client events can stay OFF until Phase 7 (typing).
# If these are empty, the app still delivers messages via short polling.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"

# These are exposed to the browser (safe — they are public keys)
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ─── Trinetra AI (Scam Detection Integration) ────────────────────────────────
# Base URL of the Trinetra AI Flask backend (no trailing slash).
# The Secure Chat backend calls this server-to-server for message analysis.
# Set to empty string to disable Trinetra analysis (messages still deliver).
TRINETRA_API_URL="http://localhost:5000"
# Timeout in milliseconds for Trinetra AI analysis requests.
TRINETRA_TIMEOUT_MS="10000"

# ─── Multilingual TTS (Edge TTS) ──────────────────────────────────────────────
# Install the Python dependency with: python -m pip install edge-tts
# Set this only when the project-local .venv is not being used.
EDGE_TTS_PYTHON=""
